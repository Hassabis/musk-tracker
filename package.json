    "test": "node --experimental-strip-types --test server/*.test.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "motion": "14.6.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3"
  },
  "engines": {
    "node": "24.x"
  }
}
